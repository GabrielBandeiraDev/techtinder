APP_NAME=TechMatchmakers API
DEBUG=true

# --- Render (produção) ---
# DEBUG=false
# CORS_ORIGINS=https://seu-app.vercel.app,https://techtinder.vercel.app
# SUPABASE_USE_POOLER=true
# SUPABASE_POOLER_HOST=aws-0-sa-east-1.pooler.supabase.com
# (uploads em ./data/uploads são efêmeros no plano Free — use Supabase Storage depois)

# --- Supabase (recomendado em produção) ---
# Dashboard → Settings → API
SUPABASE_PROJECT_ID=seu-project-id
SUPABASE_URL=https://seu-project-id.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-secret-key

# Dashboard → Settings → Database → Database password
SUPABASE_DB_PASSWORD=sua-senha-do-banco

# Opcional: host customizado (senão usa db.{SUPABASE_PROJECT_ID}.supabase.co)
# SUPABASE_DB_HOST=db.seu-project-id.supabase.co

# Pooler (mais rápido com FastAPI) — Dashboard → Database → Connection pooling → Transaction
# SUPABASE_USE_POOLER=true
# SUPABASE_POOLER_HOST=aws-0-sa-east-1.pooler.supabase.com

# Pool de conexões (conexão direta porta 5432)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Opcional: connection string completa (sobrescreve montagem automática acima)
# Render: pode usar só DATABASE_URL em vez de SUPABASE_* (troque postgresql:// por postgresql+asyncpg://)
# DATABASE_URL=postgresql+asyncpg://postgres:SENHA@db.seu-project-id.supabase.co:5432/postgres?ssl=require
# Se já rodou supabase/schema.sql: SKIP_ALEMBIC=1 no Render (migrações só no start, não no build)

# --- SQLite local (só dev sem Supabase) ---
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=5
RATE_LIMIT_DEFAULT=100/minute
